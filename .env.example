# Client-ID (Anwendungs-ID) deiner eigenen App-Registrierung bei Microsoft.
# Anleitung: siehe README.md, Abschnitt "Einrichtung".
# Alternativ beim ersten Start in der App eintragen.
BILDERKATALOG_CLIENT_ID=

# Optional: eigenes Datenverzeichnis (Datenbank, Token-Cache, Vorschaubilder)
# BILDERKATALOG_DATA_DIR=

# Optional: Anmelde-Authority. Standard "consumers" (private Microsoft-Konten).
# BILDERKATALOG_AUTHORITY=https://login.microsoftonline.com/consumers
